{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Where the world searches for sports cards",
  "width": 680, "height": 360,
  "projection": {"type": "equalEarth"},
  "layer": [
    {"data": {"sphere": true}, "mark": {"type": "geoshape", "fill": "#eef4f8"}},
    {"data": {"graticule": {"step": [30, 30]}}, "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 0.5}},
    {"data": {"url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json", "format": {"type": "topojson", "feature": "countries"}},
     "transform": [{"lookup": "properties.name", "from": {"data": {"url": "data/trends_country.csv"}, "key": "Country", "fields": ["Interest"]}},
                   {"calculate": "datum.Interest ? toNumber(datum.Interest) : null", "as": "Interest"}],
     "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.4},
     "encoding": {"color": {"condition": {"test": "datum.Interest != null", "field": "Interest", "type": "quantitative", "scale": {"scheme": "oranges"}, "legend": {"title": "Search interest (0–100)"}}, "value": "#d9d9d9"},
                  "tooltip": [{"field": "properties.name", "type": "nominal", "title": "Country"}, {"field": "Interest", "type": "quantitative", "title": "Interest"}]}}
  ]
}
