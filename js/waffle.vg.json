{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Who grades the record breakers?",
    "subtitle": "Each square is one of the 14 record card sales, grouped by grading company"
  },
  "width": 420,
  "height": 140,
  "data": {
    "url": "data/record_sales.csv"
  },
  "transform": [
    {
      "calculate": "indexof(['PSA','BGS','SGC','Not stated'], datum.Grader)",
      "as": "gorder"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "id"
        }
      ],
      "sort": [
        {
          "field": "gorder"
        },
        {
          "field": "PriceUSD",
          "order": "descending"
        }
      ]
    },
    {
      "calculate": "(datum.id - 1) % 7",
      "as": "col"
    },
    {
      "calculate": "floor((datum.id - 1) / 7)",
      "as": "row"
    }
  ],
  "mark": {
    "type": "square",
    "size": 1800,
    "opacity": 1
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null
    },
    "color": {
      "field": "Grader",
      "type": "nominal",
      "sort": [
        "PSA",
        "BGS",
        "SGC",
        "Not stated"
      ],
      "scale": {
        "domain": [
          "PSA",
          "BGS",
          "SGC",
          "Not stated"
        ],
        "range": [
          "#e6550d",
          "#3182bd",
          "#31a354",
          "#cccccc"
        ]
      },
      "legend": {
        "orient": "right",
        "title": "Grading company"
      }
    },
    "tooltip": [
      {
        "field": "Player"
      },
      {
        "field": "Card"
      },
      {
        "field": "Grader"
      },
      {
        "field": "Grade"
      },
      {
        "field": "PriceUSD",
        "format": "$,.0f",
        "title": "Price (US$)"
      }
    ]
  },
  "view": {
    "stroke": null
  }
}